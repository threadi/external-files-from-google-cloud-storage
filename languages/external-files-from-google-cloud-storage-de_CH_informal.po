#. Plugin Name of the plugin
#: external-files-from-google-cloud-storage.php
msgid "External files from Google Cloud Storage in Media Library"
msgstr "Externe Dateien aus dem Google Cloud Storage in der Mediathek"

#. Description of the plugin
#: external-files-from-google-cloud-storage.php
msgid "Extends External files in Media Library for usage of Google Cloud Storage."
msgstr "Erweitere Externe Dateien in der Mediathek mit Google Cloud Storage."

#. Author of the plugin
#: external-files-from-google-cloud-storage.php
msgid "Thomas Zwirner"
msgstr "Thomas Zwirner"

#. Author URI of the plugin
#: external-files-from-google-cloud-storage.php
msgid "https://www.thomaszwirner.de"
msgstr "https://www.thomaszwirner.de"

#: app/GoogleCloudStorage.php:128
msgid "Choose file(s) from your Google Cloud Storage"
msgstr "Wähle Datei(en) von deinem Google Cloud Storage"

#: app/GoogleCloudStorage.php:194 app/GoogleCloudStorage.php:202 app/GoogleCloudStorage.php:851 app/GoogleCloudStorage.php:993
msgid "Authentication JSON"
msgstr "Authentifizierung JSON"

#. translators: %1$s will be replaced by a URL.
#: app/GoogleCloudStorage.php:204 app/GoogleCloudStorage.php:853
#, php-format
msgid "Get the authentication JSON by editing your service account <a href=\"%1$s\" target=\"_blank\">here (opens in a new window)</a>."
msgstr "Rufe die Authentifizierungs-JSON ab, indem du dein Dienstkonto <a href=\"%1$s\" target=\"_blank\">hier</a> bearbeitest <a href=\"%1$s\" target=\"_blank\">(wird in einem neuen Fenster geöffnet)</a>."

#: app/GoogleCloudStorage.php:210 app/GoogleCloudStorage.php:218 app/GoogleCloudStorage.php:857 app/GoogleCloudStorage.php:1002
msgid "Bucket"
msgstr "Bucket"

#: app/GoogleCloudStorage.php:219 app/GoogleCloudStorage.php:858
msgid "Set the name of the bucket to use for external files. Leave this field empty if you want to connect to different buckets."
msgstr "Lege den Namen des Buckets fest, der für externe Dateien verwendet werden soll. Lasse dieses Feld leer, wenn du eine Verbindung zu verschiedenen Buckets herstellen möchtest."

#: app/GoogleCloudStorage.php:228
msgid "Files in storage"
msgstr "Dateien im Speicher"

#: app/GoogleCloudStorage.php:229
msgid "View and import files"
msgstr "Zeige und importiere Dateien"

#: app/GoogleCloudStorage.php:240
msgid "Hint"
msgstr "Hinweis"

#. translators: %1$s will be replaced by a URL.
#: app/GoogleCloudStorage.php:242
#, php-format
msgid "Each user will find its settings in his own <a href=\"%1$s\">user profile</a>."
msgstr "Jeder Benutzer findet seine Einstellungen in seinem eigenem <a href=\"%1$s\">Benutzerprofil</a>."

#: app/GoogleCloudStorage.php:284 app/GoogleCloudStorage.php:293 app/GoogleCloudStorage.php:779
msgid "<strong>Given JSON is not valid!</strong> Please use the JSON given to you by Google Cloud."
msgstr "<strong>Die angegebene JSON-Datei ist ungültig!</strong> Bitte verwende die von Google Cloud bereitgestellte JSON-Datei."

#. translators: %1$s will be replaced by a URL.
#: app/GoogleCloudStorage.php:483
#, php-format
msgid "Google Cloud Storage object could not be loaded. Take a look at the <a href=\"%1$s\" target=\"_blank\">log</a> for more information."
msgstr "Das Google Cloud Storage-Objekt konnte nicht geladen werden. Weitere Informationen findest du im <a href=\"%1$s\" target=\"_blank\">Protokoll</a>."

#: app/GoogleCloudStorage.php:497
msgid "Google Cloud Storage bucket does not exist."
msgstr "Der Google Cloud Storage-Bucket existiert nicht."

#: app/GoogleCloudStorage.php:501
msgid "Given bucket does not exist."
msgstr "Der angegebene Bucket existiert nicht."

#: app/GoogleCloudStorage.php:509 app/GoogleCloudStorage.php:646 app/GoogleCloudStorage/Export.php:87 app/GoogleCloudStorage/Protocol.php:440 app/GoogleCloudStorage/Protocol.php:535
