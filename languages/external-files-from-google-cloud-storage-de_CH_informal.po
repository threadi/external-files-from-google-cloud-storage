msgid "Go to your bucket"
msgstr "Gehe zu deinem Bucket"

#: app/GoogleCloudStorage.php:707
msgid "Settings"
msgstr "Einstellungen"

#: app/GoogleCloudStorage.php:711
msgid "Save active directory as your external source"
msgstr "Speichere das aktuelle Verzeichnis als externe Quelle"

#: app/GoogleCloudStorage.php:806
msgid "The following error occurred during requesting the credential file for Google Cloud Storage:"
msgstr "Beim Abrufen der Anmeldedatei für Google Cloud Storage ist ein Fehler aufgetreten:"

