msgid "Google Cloud Storage"
msgstr "Google Cloud Storage"

#: app/GoogleCloudStorage.php:994
msgid "Enter your authentication JSON here"
msgstr "Gib hier deine Authentifizierungs-JSON ein"

#: app/GoogleCloudStorage.php:1003
msgid "Your bucket"
msgstr "Dein Bucket"

#: app/GoogleCloudStorage.php:1025
msgid "Connect to your Google Cloud Storage"
msgstr "Verbinde zu deinem Google Cloud Storage"

#: app/GoogleCloudStorage.php:1029
msgid "Enter your access credentials"
msgstr "Gibt deine Zugangsdaten ein"

#: app/GoogleCloudStorage.php:1044
msgid "An authentication JSON has already been set by an administrator in the plugin settings. Just connect for show the files."
msgstr "Eine Authentifizierungs-JSON wurde bereits von einem Administrator in den Plugin-Einstellungen festgelegt. Stelle einfach eine Verbindung her, um die Dateien anzuzeigen."

#: app/GoogleCloudStorage.php:1048
msgid "An authentication JSON must be set by an administrator in the plugin settings."
msgstr "Eine Authentifizierungs-JSON muss von einem Administrator in den Plugin-Einstellungen festgelegt werden."

#. translators: %1$s will be replaced by a URL.
#: app/GoogleCloudStorage.php:1053
#, php-format
msgid "Set your authentication JSON <a href=\"%1$s\">here</a>."
msgstr "Lege deine Authentifizierungs-JSON <a href=\"%1$s\">hier</a> fest."

#. translators: %1$s will be replaced by a URL.
#: app/GoogleCloudStorage.php:1057
#, php-format
msgid "Your access token is already set <a href=\"%1$s\">here</a>. Just connect for show the files."
msgstr "Dein Zugriffstoken ist bereits <a href=\"%1$s\">hier</a> eingerichtet. Stelle einfach eine Verbindung her, um die Dateien anzuzeigen."

#. translators: %1$s will be replaced by a URL.
#: app/GoogleCloudStorage.php:1064
#, php-format
msgid "Set your authentication JSON <a href=\"%1$s\">in your profile</a>."
msgstr "Lege deine Authentifizierungs-JSON <a href=\"%1$s\">in deinem Profil</a> fest."

#. translators: %1$s will be replaced by a URL.
#: app/GoogleCloudStorage.php:1068
#, php-format
msgid "Your authentication JSON is already set <a href=\"%1$s\">in your profile</a>. Just connect for show the files."
msgstr "Deine Authentifizierungs-JSON ist bereits <a href=\"%1$s\">in deinem Profil</a> festgelegt. Stelle einfach eine Verbindung her, um die Dateien anzuzeigen."

#. translators: %1$s will be replaced by a URL.
#: app/GoogleCloudStorage.php:1072
#, php-format
msgid "Get the authentication JSON by editing your service account <a href=\"%1$s\" target=\"_blank\">here</a> and enter the name of the bucket you want to connect to."
msgstr "Rufe die Authentifizierungs-JSON ab, indem du dein Dienstkonto <a href=\"%1$s\" target=\"_blank\">hier</a> bearbeitest und den Namen des Buckets eingibst, mit dem du dich verbinden möchtest."

