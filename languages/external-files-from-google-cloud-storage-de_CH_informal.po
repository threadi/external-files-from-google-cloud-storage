msgstr "Die angegebene URL ist bereits in deiner Medienbibliothek vorhanden."

#. translators: %1$s will be replaced by a URL.
#: app/GoogleCloudStorage/Protocol.php:141 app/GoogleCloudStorage/Protocol.php:192
#, php-format
msgid "Error during request of file data from Google Cloud Storage. Check the <a href=\"%1$s\" target=\"_blank\">log</a> for detailed information."
msgstr "Fehler beim Abrufen von Dateidaten aus Google Cloud Storage. Detaillierte Informationen findest du im <a href=\"%1$s\" target=\"_blank\">Protokoll</a>."

#: app/GoogleCloudStorage/Protocol.php:279
msgid "Private file could not be loaded from Google Cloud Storage:"
msgstr "Die private Datei konnte nicht aus Google Cloud Storage geladen werden:"

#: app/GoogleCloudStorage/Protocol.php:331
